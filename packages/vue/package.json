{
  "name": "@v-grid/vue",
  "description": "Vue.js specific component implementations of @v-grid/core",
  "version": "0.3.3",
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "dist/v-grid-vue.umd.js",
  "module": "dist/v-grid-vue.es.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/v-grid-vue.es.js",
      "require": "./dist/v-grid-vue.umd.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/vue.css"
  },
  "scripts": {
    "build": "vue-tsc -b && vite build --outDir dist",
    "prepublishOnly": "npm run build",
    "test": "vite test -c ./test/vite.config.test.ts"
  },
  "dependencies": {
    "@v-grid/core": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.0"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  }
}
